          "type": "string"
        },
        "target_path": {
          "type": "string"
        }
      },
      "required": [
        "path",
        "resolution"
      ],
      "type": "object"
    },
    "reconcile_FileTuple": {
      "additionalProperties": false,
      "properties": {
        "Mtime": {
