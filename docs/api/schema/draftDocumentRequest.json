            "",
            "strict",
            "available_sources"
          ],
          "type": "string"
        },
        "no_effect_tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "other": {
          "$ref": "#/$defs/desiredProfileDTO"
        },
        "other_tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "schema_version": {
          "type": "integer"
        },
        "unmatched": {
          "$ref": "#/$defs/desiredProfileDTO"
        }
      },
      "type": "object"
    },
    "draftMemberRequest": {
      "additionalProperties": false,
      "properties": {
        "excluded": {
          "type": "boolean"
        },
        "member_id": {
          "type": "string"
        },
        "overrides": {
          "anyOf": [
            {
              "$ref": "#/$defs/draftOverridesRequest"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "draftOverridesRequest": {
      "additionalProperties": false,
      "properties": {
        "matched": {
          "anyOf": [
            {
              "$ref": "#/$defs/desiredProfileDTO"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "anyOf": [
            {
              "enum": [
                "strict",
                "available_sources"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "no_effect_tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "other": {
          "anyOf": [
            {
              "$ref": "#/$defs/desiredProfileDTO"
            },
            {
              "type": "null"
            }
          ]
        },
        "other_tags": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "unmatched": {
          "anyOf": [
            {
              "$ref": "#/$defs/desiredProfileDTO"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    }
  },
  "$id": "draftDocumentRequest.json",
  "$ref": "#/$defs/draftDocumentRequest",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "draftDocumentRequest"
}
