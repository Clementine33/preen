    "audioOutputSpecDTO": {
      "additionalProperties": false,
      "properties": {
        "codec": {
          "type": "string"
        },
        "quality": {
          "$ref": "#/$defs/audioQualityDTO"
        }
      },
      "type": "object"
    },
    "audioQualityDTO": {
      "additionalProperties": false,
      "properties": {
        "bitrate": {
          "type": "integer"
        },
        "kind": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "desiredProfileDTO": {
      "additionalProperties": false,
      "properties": {
        "encoded": {
          "$ref": "#/$defs/audioOutputSpecDTO"
        },
        "lossless": {
          "$ref": "#/$defs/audioOutputSpecDTO"
        }
      },
      "type": "object"
    },
    "draftDocumentRequest": {
      "additionalProperties": false,
      "properties": {
        "delete_mode": {
          "enum": [
            "",
            "soft",
            "hard"
          ],
          "type": "string"
        },
        "matched": {
          "$ref": "#/$defs/desiredProfileDTO"
        },
        "members": {
