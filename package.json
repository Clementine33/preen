{
  "name": "preen",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev:web": "node scripts/dev-web.mjs",
    "build:web": "pnpm -C frontend/web build",
    "test:web": "pnpm -C frontend/web test",
    "typecheck:web": "pnpm -C frontend/web typecheck",
    "lint:web": "pnpm -C frontend/web lint",
    "ci:quality": "pnpm install --frozen-lockfile && pnpm lint:web && pnpm typecheck:web && pnpm test:web && pnpm build:web"
  },
  "devDependencies": {
    "vite-plugin-vue-devtools": "^8.2.1"
  }
}