{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "Asia/Singapore",
  "schedule": ["* * 1-7 * 6"],
  "ignoreDeps": ["go"],
  "prConcurrentLimit": 3,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["^ffmpeg = \"(?<currentValue>[^\"]+)\"\\r?$"],
      "depNameTemplate": "FFmpeg/FFmpeg",
      "datasourceTemplate": "github-tags",
      "extractVersionTemplate": "^n(?<version>\\d+\\.\\d+(?:\\.\\d+)?)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^mise\\.toml$/"],
      "matchStrings": ["^(?<depName>lame|opus|zlib) = \"(?<currentValue>[^\"]+)\"\\r?$"],
      "depNameTemplate": "alpine_3_24/{{depName}}",
      "datasourceTemplate": "repology",
      "extractVersionTemplate": "^(?<version>[^-]+)-r\\d+$",
      "versioningTemplate": "loose"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "GitHub Actions non-major",
      "groupSlug": "github-actions-non-major"
    }
  ]
}
