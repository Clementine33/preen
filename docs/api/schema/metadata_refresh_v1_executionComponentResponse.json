{
  "$defs": {
    "executionComponentResponse": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "stage": {
                "const": "skipped"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "task_result": {
                "$ref": "refresh_Outcome.json"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "stage": {
                "const": "metadata"
              }
            },
            "required": [
              "stage"
            ]
          },
          "then": {
            "properties": {
              "task_result": {
                "$ref": "refresh_WorkResult.json"
              }
            }
          }
        }
      ],
      "properties": {
        "committed": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "completed_operations": {
          "type": "integer"
        },
        "component_id": {
          "type": "string"
        },
        "component_index": {
          "type": "integer"
        },
        "error_code": {
          "type": "string"
        },
        "error_message": {
          "type": "string"
        },
        "inventory_sync_error": {
          "type": "string"
        },
        "inventory_synced": {
          "type": "boolean"
        },
        "kept_decisions": {
          "maxItems": 0,
          "type": "array"
        },
        "operations": {
          "type": "integer"
        },
        "partition": {
          "type": "string"
        },
        "recovery": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "remaining": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "removed": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ]
        },
        "root_path": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "task_result": {
          "oneOf": [
            {
              "$ref": "refresh_Outcome.json"
            },
            {
              "$ref": "refresh_WorkResult.json"
            }
          ]
        }
      },
      "required": [
        "kept_decisions",
        "component_index",
        "component_id",
        "root_path",
        "partition",
        "status",
        "operations",
        "completed_operations",
        "committed",
        "removed",
        "remaining",
        "recovery",
        "inventory_synced"
      ],
      "type": "object"
    }
  },
  "$id": "metadata_refresh_v1_executionComponentResponse.json",
  "$ref": "#/$defs/executionComponentResponse",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "metadata_refresh_v1_executionComponentResponse"
}
